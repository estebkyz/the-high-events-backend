# Copie este archivo a .env (nunca lo suba al repositorio)
NODE_ENV=development
PORT=3000
# Orígenes permitidos del frontend (Vite usa 8443 en este proyecto)
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

DB_HOST=127.0.0.1
DB_PORT=3306
# En producción la API no arranca con root ni con la clave vacía
DB_USER=root
DB_PASSWORD=
DB_NAME=the_high_events_db
DB_POOL=10
# off (local) · require (cifra) · verify (cifra y verifica el certificado)
DB_SSL=off

# Mínimo 32 caracteres. Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
# Número de proxies delante de la API (0 = ninguno; 1 con Nginx, Render, Railway…)
TRUST_PROXY=0

# Solo para `npm run seed` (crea el administrador; borre ADMIN_PASSWORD después)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DOCUMENTO=
ADMIN_NOMBRE=
ADMIN_APELLIDO=

# Solo para `npm run demo` (datos ficticios): clave de los usuarios de demostración.
# Vacía = clave aleatoria que nadie conoce; el administrador la restablece desde Usuarios.
DEMO_PASSWORD=
