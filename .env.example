# Copie este archivo a .env (nunca lo suba al repositorio)
NODE_ENV=development
PORT=3000
# Orígenes permitidos del frontend (Vite usa 8443 en este proyecto)
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=the_high_events_db

# Mínimo 32 caracteres. Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
RESET_TOKEN_MINUTES=30

# Solo para `npm run seed` (crea el administrador; borre ADMIN_PASSWORD después)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DOCUMENTO=
ADMIN_NOMBRE=
ADMIN_APELLIDO=
